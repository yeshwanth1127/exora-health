# Local backend serves the tracked call screen. Use /talk/ behind the clinic proxy.
VITE_VOICE_URL=http://127.0.0.1:8000/talk/

# Local unified staff workspace and voice API (Vite development only).
HMS_BACKEND_PROXY=http://127.0.0.1:8000
# This client demo uses the local appointment walkthrough by default.
# Set live only after the client's roster and booking backend are configured.
VITE_BOOKING_MODE=demo
# Sample patient sign-in (no accounts are created). Leave unset in production.
# VITE_PATIENT_SIGNIN=true
