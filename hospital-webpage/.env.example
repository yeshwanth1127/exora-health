# Local backend serves the tracked call screen. Use /talk/ behind the clinic proxy.
VITE_VOICE_URL=http://127.0.0.1:8000/talk/

# Local unified staff workspace and voice API (Vite development only).
HMS_BACKEND_PROXY=http://127.0.0.1:8000
# Hosted HMS mode reads doctors and published availability from the same-origin public API.
# Production hosting must route /public/v1 to HMS; no staff credentials belong in this frontend.
VITE_BOOKING_MODE=hms
VITE_HMS_BOOKING_SITE=sri-lakshmi
# Vite development proxy only. Production uses its reverse proxy.
HMS_PUBLIC_BOOKING_PROXY=http://127.0.0.1:3059
# Explicit alternatives: demo = illustrative walkthrough; live = older /book backend.
# Sample patient sign-in (no accounts are created). Leave unset in production.
# VITE_PATIENT_SIGNIN=true
