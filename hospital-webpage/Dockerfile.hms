FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_HMS_BOOKING_SITE=sri-lakshmi
ENV VITE_BOOKING_MODE=hms VITE_HMS_BOOKING_SITE=$VITE_HMS_BOOKING_SITE
RUN npm run build

FROM nginx:1.27-alpine
# The nginx image expands this template using the deployment's private HMS_PUBLIC_API_ORIGIN.
COPY nginx.hms.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
