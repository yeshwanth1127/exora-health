# Copy to whatsapp-mvp/.env for the phone test. Never commit the real values.
WA_VERIFY_TOKEN=replace-with-a-long-random-local-string
WA_APP_SECRET=replace-with-meta-app-secret
WA_PHONE_NUMBER_ID=replace-with-meta-test-phone-number-id
WA_ACCESS_TOKEN=replace-with-meta-test-access-token
WA_GRAPH_VERSION=replace-with-current-version-like-v24.0
WA_LOCAL_PORT=8787
WA_MODE=demo
# To use the cloned booking backend locally, set WA_MODE=backend and configure:
# BACKEND_URL=http://127.0.0.1:8000
# BACKEND_WHATSAPP_SERVICE_KEY=replace-with-backend-service-key
# Keep false while the backend contains illustrative seed doctors and schedules.
WA_CLINIC_READY=false
# Approved utility reminder template with 3 body parameters: code, doctor, date/time.
# WA_REMINDER_TEMPLATE_NAME=appointment_reminder
# WA_REMINDER_TEMPLATE_LANGUAGE=en
# Optional: absolute path to a clinic-approved PNG or JPEG. Defaults to welcome.png.
# WA_WELCOME_IMAGE_PATH=/absolute/path/to/approved-clinic-image.png
# Production-only settings (inject the secrets above from a secret manager):
# WA_ENV=production
# WA_BIND_HOST=0.0.0.0
# WA_MODE=backend
# WA_CLINIC_READY=true
# WA_LIVE_NUMBER_CONFIRMED=true
# BACKEND_URL=https://private-backend.example.com
# WA_WELCOME_IMAGE_PATH=/run/clinic-assets/approved-welcome.png
