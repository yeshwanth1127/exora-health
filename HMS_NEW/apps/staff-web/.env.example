HMS_API_PROXY_TARGET=http://127.0.0.1:3038
# Local Vite development only; disabled in every production build.
VITE_HMS_DEV_LOGIN=true
# Optional local-only registered identity for the database behind HMS_API_PROXY_TARGET.
# VITE_HMS_DEV_SUBJECT=<registered staff identity>
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile
VITE_OIDC_AUDIENCE=
