{
  "name": "@hms/platform-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5190",
    "build": "node scripts/social-card.mjs && CAPTURE_STATIC_EXPORT=1 next build && node scripts/export-platform.mjs",
    "start": "node scripts/preview-platform.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/preview-platform.mjs",
    "test": "node --test scripts/*.test.mjs",
    "seo:check": "node scripts/audit-search.mjs",
    "build:server": "node scripts/social-card.mjs && next build && node scripts/package-server.mjs",
    "start:server": "node .next/standalone/apps/platform-web/server.js",
    "test:backend": "python3 -m unittest discover -s scripts -p \"*_test.py\""
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "1.49.0",
    "motion": "14.1.0",
    "next": "15.5.28",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "posthog-js": "1.438.15",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "gsap": "^3.15.0",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "22.10.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3"
  }
}
