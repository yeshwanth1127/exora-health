# Copy to .env to override. Defaults match `pnpm pg:start` and docker-compose.yml.
PG_PORT=54329
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/hms?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/hms_test?sslmode=disable
# Optional: use system PostgreSQL 18 binaries instead of the bundled ones.
# PG_BIN=/usr/lib/postgresql/18/bin
# Set to 1 to write db/schema.sql after migrating (needs pg_dump 18 on PATH).
# DBMATE_DUMP=1
# Local-only login for the hms_app role (set by db:reset). Never use in real environments.
HMS_APP_PASSWORD=hms_app_local
TEST_APP_DATABASE_URL=postgres://hms_app:hms_app_local@127.0.0.1:54329/hms_test?sslmode=disable
