{
  "name": "hms-new",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "pg:start": "node db/scripts/local-pg.mjs start",
    "pg:stop": "node db/scripts/local-pg.mjs stop",
    "pg:status": "node db/scripts/local-pg.mjs status",
    "db:migrate": "node db/scripts/dbmate.mjs up",
    "db:rollback": "node db/scripts/dbmate.mjs rollback",
    "db:status": "node db/scripts/dbmate.mjs status",
    "db:new": "node db/scripts/dbmate.mjs new",
    "db:reset": "node db/scripts/reset.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:codegen": "node db/scripts/codegen.mjs",
    "api:dev": "tsx --env-file-if-exists=.env apps/api/src/main.ts",
    "worker:dev": "tsx --env-file-if-exists=.env apps/worker/src/main.ts",
    "dev:token": "tsx apps/api/src/auth/dev-token.ts",
    "staff:dev": "pnpm --filter @hms/staff-web dev",
    "staff:build": "pnpm --filter @hms/staff-web build",
    "staff:test": "pnpm --filter @hms/staff-web test",
    "integrations:check": "tsx --env-file-if-exists=.env scripts/check-managed-integrations.ts",
    "platform:dev": "pnpm --filter @hms/platform-web dev",
    "platform:build": "pnpm --filter @hms/platform-web build",
    "control:dev": "tsx --env-file-if-exists=.env apps/control-api/src/main.ts",
    "control:up": "docker compose -f compose.platform.yml up --build -d",
    "control:down": "docker compose -f compose.platform.yml down",
    "admin:dev": "pnpm --filter @hms/admin-web dev",
    "admin:build": "pnpm --filter @hms/admin-web build",
    "public:dev": "pnpm --filter @hms/public-web dev",
    "public:build": "pnpm --filter @hms/public-web build",
    "tenant:up": "docker compose -f compose.tenant.yml up --build -d",
    "tenant:down": "docker compose -f compose.tenant.yml down",
    "tenant:provision": "node scripts/provision-tenant.mjs",
    "tenant:voice:prepare": "node scripts/prepare-tenant-voice.mjs",
    "tenant:voice": "node scripts/configure-tenant-voice.mjs",
    "website:build": "pnpm --filter @hms/sri-lakshmi-web build",
    "website:test": "pnpm --filter @hms/sri-lakshmi-web test",
    "editorial:dev": "pnpm --filter @hms/hospital-editorial-web dev",
    "editorial:build": "pnpm --filter @hms/hospital-editorial-web build",
    "editorial:test": "pnpm --filter @hms/hospital-editorial-web test",
    "apple:worker": "tsx --env-file-if-exists=.env apps/api/src/apple-worker.ts",
    "apple:demo": "tsx scripts/apple-demo.ts",
    "apple:cloud-template": "node infra/apple-connect/template.mjs",
    "apple:dashboard": "tsx scripts/apple-demo-dashboard.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "dbmate": "2.36.0",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "kysely-codegen": "0.20.0",
    "kysely": "0.29.6",
    "tsx": "4.23.15"
  }
}
